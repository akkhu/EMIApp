<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:id="@+id/tvLockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DEVICE SECURED"
        android:textColor="#FF5252"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This device has been secured due to a pending EMI payment. Please clear your dues and connect to the internet to restore access."
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textAlignment="center"
        android:layout_marginBottom="32dp"/>

    <!-- Placeholder for Payment Gateway or Unlock Code UI -->
    <Button
        android:id="@+id/btnCheckStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Check Payment Status"
        android:padding="16dp"/>

    <Button
        android:id="@+id/btnEmergencyRelease"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Emergency Offline Release"
        android:padding="16dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#FF0000"
        android:textColor="#FFFFFF"
        android:visibility="gone"/>

</LinearLayout>
