<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DEVICE LOCKED"
        android:textColor="#FF5252"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This device has been locked due to a missed EMI payment. Please connect to the internet and make a payment to unlock."
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textAlignment="center"
        android:layout_marginBottom="32dp"/>

    <!-- Placeholder for Payment Gateway or Unlock Code UI -->
    <Button
        android:id="@+id/btnCheckStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Check Payment Status"
        android:padding="16dp"/>

</LinearLayout>
